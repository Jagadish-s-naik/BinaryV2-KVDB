#!/usr/bin/env python3
"""Launcher for kvdb."""

import sys
from pathlib import Path

# Add src to sys.path so 'import kvdb' works cleanly without pip install
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from kvdb.__main__ import main

if __name__ == "__main__":
    sys.exit(main())

