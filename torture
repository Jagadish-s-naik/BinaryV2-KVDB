#!/usr/bin/env python3
"""Independent torture tool for kvdb."""

import sys
import os
import argparse
from pathlib import Path


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(description="kvdb torture tool")
    parser.add_argument("--seed", required=True, help="Master seed (integer or string)")
    parser.add_argument("--iterations", type=int, default=500, help="Number of kill/restart cycles")
    parser.add_argument("--mode", default="default", help="Torture mode (default, crash-points, etc.)")
    parser.add_argument("--workdir", default="./torture-work", help="Working directory (real disk)")
    parser.add_argument("--writers", type=int, default=2, help="Concurrent writer threads")
    parser.add_argument("--inflight", type=int, default=16, help="Max in-flight operations per writer")
    parser.add_argument("--kill-min-ms", type=int, default=5, help="Minimum kill delay in ms")
    parser.add_argument("--kill-max-ms", type=int, default=600, help="Maximum kill delay in ms")
    parser.add_argument("--kvdb", default=str(Path(__file__).resolve().parent / "kvdb"), help="Path to kvdb binary")

    args = parser.parse_args(argv)

    print(f"kvdb torture runner initialized with seed={args.seed}, mode={args.mode}, iterations={args.iterations}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

